# Casuya Payments microservice
APP_NAME=casuya-payments
ENVIRONMENT=development
DATABASE_URL=sqlite:///./casuya_payments.db

# Internal API key (platform sends as X-API-Key). Required in production.
API_KEY=

# AzamPay — set AZAMPAY_MOCK=true for local dev without credentials
AZAMPAY_MOCK=true
AZAMPAY_SANDBOX=true
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_APP_NAME=casuya
AZAMPAY_X_API_KEY=
AZAMPAY_CALLBACK_URL=
AZAMPAY_WEBHOOK_SECRET=
