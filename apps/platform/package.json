{
  "name": "casuya-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Student/admin/teacher platform for Casuya (casuya.co.tz)",
  "scripts": {
    "dev:backend": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npx serve frontend -l 5173",
    "seed": "python -m database.seeds.seed_dev_data",
    "reseed": "python -m database.seeds.reseed",
    "create-admin": "python -m database.seeds.create_admin",
    "test": "python -m pytest tests/backend -q && node --test tests/frontend/render-exam-paper.test.mjs",
    "test:frontend": "node --test tests/frontend/render-exam-paper.test.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:edge": "playwright test -c e2e/playwright.edge.config.ts",
    "test:coverage": "pytest tests/ --cov=backend --cov=integrations -v",
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').writeFileSync('dist/build-info.json', JSON.stringify({note:'Static frontend is built in apps/platform/frontend (CI + Vercel); this marker exists so turbo has a real output for casuya-platform#build.'}))\"",
    "docker:up": "docker compose -f ../infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f ../infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "serve": "^14.2.0"
  }
}
