APP_NAME="Casuya Platform"
ENVIRONMENT=development
DEBUG=true

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/casuya_platform

# Redis
REDIS_URL=redis://localhost:6379

# Abort boot when the primary database is unreachable (recommended in production).
REQUIRE_DATABASE_ON_STARTUP=false

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Casuya Core Signing
CASUYA_CORE_SIGNING_KEY=
CASUYA_BRIDGE_SHARED_KEY=

# Casuya Payments microservice
CASUYA_PAYMENTS_URL=http://localhost:3002
CASUYA_PAYMENTS_API_KEY=

# Handwriting OCR (Mathpix via platform proxy — credentials never sent to browser)
OCR_PROVIDER=none
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Casuya AI microservice (holds the AI API keys: GROQ_API_KEY, GOOGLE_API_KEY,
# MISTRAL_API_KEY, GROK_API_KEY, etc.). Used for AI-driven lesson-plan and
# scheme-of-work generation plus tutoring/questions.
CASUYA_AI_URL=https://casuya-ai-production.up.railway.app
CASUYA_AI_API_KEY=

# Optional: service token if syllabus AI routes require auth in your deployment
CASUYA_PLATFORM_URL=https://casuya-platform-production.up.railway.app
CASUYA_PLATFORM_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# AzamPay
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_APP_NAME=
AZAMPAY_X_API_KEY=
AZAMPAY_SANDBOX=true

# Africa's Talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Brevo SMTP (transactional email)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
EMAIL_FROM=no-reply@casuya.co.tz
EMAIL_FROM_NAME=Casuya
FRONTEND_RESET_URL=https://casuya.co.tz/reset-password.html

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://casuya.co.tz
FRONTEND_BASE=https://casuya.co.tz

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sentry (error tracking)
SENTRY_DSN=

# Storage
STORAGE_ROOT=./storage

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Casuya Audio-TTS microservice (Sherpa-ONNX TTS, Railway-hosted over railway.internal)
CASUYA_AUDIO_TTS_URL=http://localhost:8010
CASUYA_AUDIO_TTS_API_KEY=
# Casuya Audio-STT microservice (Sherpa-ONNX, Railway-hosted)
CASUYA_AUDIO_STT_URL=http://localhost:8020
CASUYA_AUDIO_STT_API_KEY=
