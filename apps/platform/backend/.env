DB_POOL_PRE_PING=true

jwt_secret=QYNUOkSMGjB4rhIsgtc0LDm7Z6bvKwyHJlW1fPpzC8VxTdFoXRq93AEuine5a2
jwt_algorithm=HS256
access_token_expire_minutes=15
