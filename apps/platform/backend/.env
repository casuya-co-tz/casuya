app_name=Casuya Platform
environment=production
debug=false

# Neon serverless Postgres (pooled connection string)
database_url=${NEON_DATABASE_URL}
DATABASE_URL=${NEON_DATABASE_URL}

# Upstash Redis (TLS TCP endpoint for the Python redis library)
redis_url=rediss://default:gQAAAAAAAn6hAAIgcDEwZmU3MTAyZTQ3OWM0YjAxYjc1ZGE1NmIzNWY3ZWQ0NQ@included-zebra-163489.upstash.io:6379
