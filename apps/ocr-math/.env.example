"""
Casuya Math OCR microservice (.env.example).

Same internal key the platform backend sends as X-API-Key on every call.
"""

# Internal API key required by POST /v1/ocr/recognize (mirrors audio services).
# Set the SAME value as the platform's CASUYA_OCR_API_KEY here.
# API_KEY=

# Optional override for a pre-baked model directory (empty = Pix2Text defaults).
# OCR_MODELS_DIR=