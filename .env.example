# Casuya Hybrid — environment variables
# Mirrors the production Render environment (casuya-platform/render.yaml).
# Copy this file to `.env` and fill in real secrets for deployment.

# --- Core app ---
APP_ENV=production
ENVIRONMENT=production
DEBUG=false
PORT=8765

# --- Database (matches docker-compose postgres service) ---
DATABASE_URL=postgresql://postgres:Mkalanga1994!@postgres:5432/casuya_platform

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0

# --- Security (CHANGE THESE in production) ---
JWT_SECRET=change-me
SESSION_SECRET=change-me

# --- CORS / allowed origins ---
ALLOWED_ORIGINS=*
CORS_ORIGINS=*

# --- Casuya Payments microservice (shared secret; must match API_KEY in apps/payments/.env) ---
CASUYA_PAYMENTS_API_KEY=

# Audio microservices (Railway internal URLs + shared X-API-Key)
CASUYA_AUDIO_TTS_URL=http://localhost:8010
CASUYA_AUDIO_STT_URL=http://localhost:8020
CASUYA_AUDIO_TTS_API_KEY=
CASUYA_AUDIO_STT_API_KEY=

# Casuya AI microservice (shared X-API-Key)
CASUYA_AI_URL=http://localhost:3000
CASUYA_AI_API_KEY=
# Used by casuya-ai SyllabusAdapter to fetch TIE curriculum from platform
CASUYA_PLATFORM_URL=http://localhost:8000
CASUYA_PLATFORM_API_KEY=

# Cloudflare (casuya.co.tz) — token stays secret; IDs are public zone identifiers
CLOUDFLARE_ZONE_ID=902d9fb7b7d88c2f7b8a20a8dffefaa1
CLOUDFLARE_ACCOUNT_ID=0f79cf0abd1bfed2afb8594bdecd196a
CLOUDFLARE_API_TOKEN=
# R2 S3 API (object migration). Public browser origin is PUBLIC_ASSETS_BASE, not the S3 endpoint.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=casuya-uploads
R2_S3_ENDPOINT=https://0f79cf0abd1bfed2afb8594bdecd196a.r2.cloudflarestorage.com
# Optional https origin for immutable uploads (R2 custom domain / CDN)
# PUBLIC_ASSETS_BASE=https://cdn.casuya.co.tz

# Handwriting OCR — self-hosted provider (Pix2Text microservice) or Mathpix
# (platform proxy keeps keys server-side)
OCR_PROVIDER=none  # none | mathpix | self-hosted
CASUYA_OCR_URL=http://localhost:8030
CASUYA_OCR_API_KEY=
# Optional Mathpix fallback
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=

# --- Initial admin account (used by database.seeds.create_admin) ---
CASUYA_ADMIN_NAME=Admin
CASUYA_ADMIN_EMAIL=admin@casuya.co.tz
CASUYA_ADMIN_PASSWORD=change-me
