# Casuya Hybrid — environment variables
# Mirrors the production Render environment (casuya-platform/render.yaml).
# Copy this file to `.env` and fill in real secrets for deployment.

# --- Core app ---
APP_ENV=production
ENVIRONMENT=production
DEBUG=false
PORT=8765

# --- Database (matches docker-compose postgres service) ---
DATABASE_URL=postgresql://postgres:Mkalanga1994!@postgres:5432/casuya_platform

# --- Cache / queue ---
REDIS_URL=redis://redis:6379/0

# --- Security (CHANGE THESE in production) ---
JWT_SECRET=change-me
SESSION_SECRET=change-me

# --- CORS / allowed origins ---
ALLOWED_ORIGINS=*
CORS_ORIGINS=*

# --- Casuya Payments microservice (shared secret; must match API_KEY in apps/payments/.env) ---
CASUYA_PAYMENTS_API_KEY=

# Audio microservices (Railway internal URLs + shared X-API-Key)
CASUYA_AUDIO_TTS_URL=http://localhost:8010
CASUYA_AUDIO_STT_URL=http://localhost:8020
CASUYA_AUDIO_TTS_API_KEY=
CASUYA_AUDIO_STT_API_KEY=

# --- Initial admin account (used by database.seeds.create_admin) ---
CASUYA_ADMIN_NAME=Admin
CASUYA_ADMIN_EMAIL=admin@casuya.co.tz
CASUYA_ADMIN_PASSWORD=change-me
