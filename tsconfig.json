{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@casuya/core": ["libs/core/casuya_core"],
      "@casuya/runtime": ["packages/runtime/src"],
      "@casuya/bridge": ["packages/bridge/src"],
      "@casuya/editor": ["packages/editor/src"],
      "@casuya/blackboard": ["packages/blackboard/src"],
      "@casuya/ds-tokens": ["packages/ds-tokens/src"],
      "@casuya/ds-react": ["packages/ds-react/src"],
      "@casuya/ds-a11y": ["packages/ds-a11y/src"],
      "@casuya/ds-hooks": ["packages/ds-hooks/src"],
      "@casuya/ds-icons": ["packages/ds-icons/src"],
      "@casuya/ds-styles": ["packages/ds-styles/src"],
      "@casuya/ds-utils": ["packages/ds-utils/src"],
      "@casuya/ds-theme": ["packages/ds-theme/src"],
      "@casuya/ai": ["packages/ai/src"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/build", "**/.next", "**/.turbo"]
}
