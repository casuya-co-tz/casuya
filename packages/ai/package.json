{
  "name": "casuya-ai",
  "version": "0.1.0",
  "description": "Personal AI Teacher — Intelligent educational assistance for Casuya",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run build:server",
    "build:server": "tsc server.ts --outDir dist --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck --strict --declaration false --sourceMap false",
    "clean": "rimraf dist",
    "lint": "eslint src/ tests/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern='tests/unit'",
    "test:integration": "jest --config jest.config.js --testPathPattern='tests/integration'",
    "typecheck": "tsc --noEmit && tsc --noEmit server.ts --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck --strict",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "education",
    "ai",
    "tutoring",
    "casuya",
    "learning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/casuya/casuya-ai.git"
  },
  "bugs": {
    "url": "https://github.com/casuya/casuya-ai/issues"
  },
  "homepage": "https://github.com/casuya/casuya-ai#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  }
}
